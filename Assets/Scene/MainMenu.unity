  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tFrankie works as a warehouse caretaker for LX Corporation. Her coworkers
    describe her as a laid back woman who simply keeps her head down and cares about
    doing her job well. She works the night shift, allowing her to attend university
    during the day, where she is pursuing a degree in physics.\r\n\n\tFrankie was
    kicked out of her home when she turned eighteen and has lived in a friend's apartment
    ever since. Between rent, living expenses, and the modest salary she earns at
    the warehouse, she struggles to stay afloat while working toward a better future.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 1a5137410791bd8429cc2bd1179989d7, type: 2}
  m_sharedMaterial: {fileID: -6074615779394195631, guid: 1a5137410791bd8429cc2bd1179989d7,
